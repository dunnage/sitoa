<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:example:other" elementFormDefault="qualified">
  <xs:simpleType name="scoreType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[0-9]{1,3}"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
