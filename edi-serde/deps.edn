{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.6"}
         metosin/malli       {:mvn/version "0.20.2"}
         net.cgrand/xforms   {:mvn/version "0.19.4"}
         io.xlate/staedi     {:mvn/version "1.22.0"}}
 :aliases
 {;; support/ (X12 helpers built on tech.ml.dataset) and the sample EDI files in
  ;; dev-resources are for tests and REPL work; the library itself needs neither
  :test    {:extra-paths ["test" "support" "dev-resources"]
            :extra-deps  {org.clojure/test.check     {:mvn/version "1.1.1"}
                          techascent/tech.ml.dataset {:mvn/version "7.060"}
                          io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.0" :git/sha "48c3c67"}}}
  :support {:extra-paths ["support" "dev-resources"]
            :extra-deps  {techascent/tech.ml.dataset {:mvn/version "7.060"}}}
  :dev     {}}}
